% Shared vector source for the English and Chinese prose editions.
\begin{tikzpicture}[
  statebox/.style={draw=rulegray,rounded corners=2pt,fill=boxgray!45,
    text width=2.30cm,minimum height=0.85cm,inner sep=3pt,
    align=center,font=\footnotesize},
  arrow/.style={-{Stealth[length=1.7mm]},semithick},
  label/.style={font=\scriptsize,fill=white,inner sep=1pt,align=center}]
\node[font=\footnotesize,align=center] at (1.75,1.15)
  {$\stsrc=(q,v)\ \xrightarrow{\ C=u\ }\ \st=(q,v,u)$};
\node[statebox,draw=auxpurple] (maintained) at (0,0)
  {$\st(S),\ \st(T)$\\[2pt]$(q_P,v_P,u_P)$};
\node[statebox,draw=fixgreen] (merged) at (3.5,0)
  {$\st(U)$\\[2pt]$(q_U,v_U,u_U)$};
\node[statebox] (reference) at (0,-1.8)
  {$\stref(S),\ \stref(T)$\\[2pt]$(q_P,u_P,p_P)$};
\node[statebox] (combined) at (3.5,-1.8)
  {$\stref(U)$\\[2pt]$(q_U,u_U,p_U)$};
\draw[arrow,draw=fixgreen] (maintained) --
  node[label,above,text=fixgreen] {$\Mrg$}
  node[label,below,text=fixgreen] {\S\ref{sec:correctness}--\ref{sec:rebase}} (merged);
\draw[arrow] (maintained) --
  node[label,right] {$H$\\\S\ref{sec:recovery}} (reference);
\draw[arrow] (reference) -- node[label,above] {$+$}
  node[label,below] {\S\ref{sec:correctness}} (combined);
\draw[arrow] (combined) --
  node[label,left] {$G$\\\S\ref{sec:selection}--\ref{sec:synthesis}} (merged);
\end{tikzpicture}
